#: logdisplay.py:410
#, python-brace-format
msgid ""
"The cash drawer {name} was closed from the back office, without a count. It "
"should have held {expected}."
msgstr ""
"La caisse espèces {name} a été fermée depuis le back office, sans comptage. "
"Elle aurait dû contenir {expected}."

#: logdisplay.py:416
#, python-brace-format
msgid ""
"The cash drawer {name} was closed from the back office on a count of "
"{amount}. It should have held {expected}."
msgstr ""
"La caisse espèces {name} a été fermée depuis le back office sur un comptage "
"de {amount}. Elle aurait dû contenir {expected}."

#: logdisplay.py:428
