include LICENSE
include README.md

recursive-include pretix_openpos/static *
recursive-include pretix_openpos/templates *
recursive-include pretix_openpos/locale *

# The PWA bundle is generated by `npm run build` and is not in version control.
# Run that before building a distribution, or the till will 404 on its own
# JavaScript.
recursive-include pretix_openpos/static/pretix_openpos/pwa *

global-exclude *.py[cod]
global-exclude __pycache__
