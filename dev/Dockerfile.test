# Image for running the backend suite: pretix, the plugin's test dependencies,
# and nothing else. The tree is bind-mounted rather than copied, so a test run
# never needs a rebuild — only a change to pretix or to the test dependencies
# below does.
#
#   docker build -f dev/Dockerfile.test -t pretix-openpos-test .
#   docker run --rm -v "$PWD:/plugin" pretix-openpos-test
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gettext \
        git \
        libffi-dev \
        libjpeg-dev \
        libopenjp2-7-dev \
        libssl-dev \
        libxml2-dev \
        libxslt1-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# The pretix the production image is built on, read out of deploy/Dockerfile
# rather than typed a second time here, so that the suite preflight runs is the
# one CI runs, against what production runs. Read by the image itself rather
# than handed in as a build argument: preflight and the command at the top of
# this file then both get the same pretix without having to be told. Copied on
# its own, just before the install, so that only an edit to that file costs a
# reinstall.
COPY deploy/Dockerfile /tmp/deploy.Dockerfile
RUN set -e; \
    version=$(sed -n 's/^ARG PRETIX_VERSION=\(.*\)$/\1/p' /tmp/deploy.Dockerfile); \
    if [ -z "$version" ]; then echo "no ARG PRETIX_VERSION in deploy/Dockerfile" >&2; exit 1; fi; \
    pip install --no-cache-dir --upgrade pip; \
    pip install --no-cache-dir "pretix==${version}.*"; \
    pip install --no-cache-dir "pytest<9" pytest-django pytest-cov; \
    rm /tmp/deploy.Dockerfile

WORKDIR /plugin
ENTRYPOINT ["/bin/sh", "-c"]
CMD ["pip install --no-deps -q -e . && pytest"]
